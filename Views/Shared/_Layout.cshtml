<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Galerie photo</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/theme.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="entete">
        <div class="entete-contenu">
            @Html.ActionLink("Galerie photo", "AfficherPhoto", "Photo", null, new { @class = "marque" })
        </div>
    </header>

    <main class="contenu">
        @RenderBody()
    </main>

    <footer class="pied">
        <p>Travaux pratiques ASP.NET MVC, @DateTime.Now.Year</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>