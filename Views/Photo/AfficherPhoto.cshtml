@model TEST1WEB.Models.Photo

@{
    ViewBag.Title = Model.Title;
}

<link href="~/Content/photo.css" rel="stylesheet" />

<article class="fiche">
    <figure class="cadre">
        <div class="image" role="img" aria-label="Emplacement de la photo : @Model.Title">
            <span>Aucune image associée</span>
        </div>
        <figcaption>
            <h1 class="titre">@Model.Title</h1>
            <p class="description">@Model.Description</p>
            <p class="credit">Photo de <strong>@Model.Author</strong></p>
        </figcaption>
    </figure>
</article>